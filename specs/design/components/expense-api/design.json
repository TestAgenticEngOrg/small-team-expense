{
  "name": "expense-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "expense-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    1,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "description": "Owns expenses and the employee/manager directory. Lets an employee submit an expense and see their own expenses, and lets a manager see and decide the expenses of the employees who report to them. Does not read receipt photos or extract fields — the webapp gets those from the extraction agent before calling this API — and does not track reimbursement/payout once an expense is decided.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "expense-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "small-team-expens-00f6e24f",
        "envBindings": {
          "dbname": "EXPENSE_DB_DBNAME",
          "host": "EXPENSE_DB_HOST",
          "password": "EXPENSE_DB_PASSWORD",
          "port": "EXPENSE_DB_PORT",
          "user": "EXPENSE_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "small-team-expens-66039da2",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
