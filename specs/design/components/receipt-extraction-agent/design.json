{
  "name": "receipt-extraction-agent",
  "type": "ai-agent",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "receipt-extraction-agent",
  "entrypoint": "deployment/ai-agent",
  "exposure": "internet",
  "stories": [
    2
  ],
  "description": "Reads a photo of a receipt and returns the vendor, date, amount and category it can make out, for the employee to review and correct before submitting the expense. Holds no expense data itself — expense-api is where a submitted expense lives — and never decides or stores anything beyond its own short conversation record.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "memory-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "small-team-expens-0f7c87ce",
        "envBindings": {
          "dbname": "MEMORY_DB_DBNAME",
          "host": "MEMORY_DB_HOST",
          "password": "MEMORY_DB_PASSWORD",
          "port": "MEMORY_DB_PORT",
          "user": "MEMORY_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "small-team-expens-66039da2",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "agent-building"
  ]
}
